# .env.example dosyasını .env adıyla kopyalayıp doldur. .env dosyası git'e girmez.

# SERVER
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=buraya-uzun-rastgele-bir-metin-yaz
DB_PATH=./data.db

# EMAIL (Zorunlu - e-posta doğrulama için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OAUTH - Google (İsteğe bağlı - sosyal giriş için)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAUTH - GitHub (İsteğe bağlı - sosyal giriş için)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 2FA & GÜVENLİK
TOTP_ISSUER=Portfolio
TOTP_WINDOW=2

# API
SWAGGER_ENABLED=true
