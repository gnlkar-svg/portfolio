# .env.example dosyasını .env adıyla kopyalayıp doldur. .env dosyası git'e girmez.

# Sitenin adresi: sıfırlama bağlantıları bununla başlar.
BASE_URL=http://localhost:3000
PORT=3000

# Oturum çerezlerini imzalamak için uzun, rastgele bir metin.
SESSION_SECRET=buraya-uzun-rastgele-bir-metin-yaz

# İsteğe bağlı: gerçek e-posta göndermek için SMTP bilgileri.
# Boş bırakılırsa sıfırlama bağlantısı sunucunun terminaline yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
